# --- Spotify ---
# Create an app at https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Must be added to the app's "Redirect URIs" in the Spotify dashboard
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8080/callback
# The playlist ID (from the playlist share link) to keep in sync
SPOTIFY_PLAYLIST_ID=

# --- YouTube Music ---
# Create an OAuth client of type "TVs and Limited Input devices" at
# https://console.cloud.google.com/apis/credentials (enable "YouTube Data API v3" first)
YTMUSIC_OAUTH_CLIENT_ID=
YTMUSIC_OAUTH_CLIENT_SECRET=
# The playlist ID (from the playlist share link, e.g. VLPL... or PL...) to keep in sync
YTMUSIC_PLAYLIST_ID=

# --- App ---
# How often to check for changes, in seconds (default: 600 = 10 minutes)
SYNC_INTERVAL_SECONDS=600
# Where the sqlite DB and cached OAuth tokens live (mounted as a volume in Docker)
DATA_DIR=/data
LOG_LEVEL=INFO
